# ============================================================
# ProofStack Environment Configuration
# ============================================================

# Application
APP_ENV=development
APP_SECRET=replace-with-a-development-secret
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://proofstack:proofstack@localhost:5432/proofstack

# Redis
REDIS_URL=redis://localhost:6379/0

# GitHub OAuth - configured in a later phase
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth - configured in a later phase
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI provider - configured in a later phase
AI_PROVIDER_API_KEY=your-ai-provider-api-key